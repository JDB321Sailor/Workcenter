# OnlyOffice/ — every variable `OnlyOffice/compose.yaml` interpolates.
#
# Copy to `OnlyOffice/.env`. Compose loads this file automatically for this
# folder's compose file, whether it is run directly
# (`docker compose -f OnlyOffice/compose.yaml up -d`) or reached through the root
# composition's `include:`. The root `.env` takes precedence over these values
# for anything both files define.
#
# Nothing here is a secret: the value below is a placeholder (A-6.12).

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# onlyoffice/documentserver:8.2.2 — a concrete patch release under the 8.2 minor
# architecture.md §6.1 pins, and the value the root `.env.example` carries. It
# must stay compatible with the OnlyOffice API version the pinned FileBrowser
# Quantum supports (roadmap.md §5.2). Move it deliberately, never to `latest`.
ONLYOFFICE_IMAGE=onlyoffice/documentserver:8.2.2

# ---------------------------------------------------------------------------
# Ingress and networks
# ---------------------------------------------------------------------------
# The editor's public address: FileBrowser sends the browser here through
# `integrations.office.url`, so the host must resolve and be reachable from the
# user's browser (integration.md §4.3). Derived as `office.<base domain>`.
OFFICE_HOST=office.example.com
# The ACME resolver name from Traefik's static configuration (production.md §7.2).
TRAEFIK_CERT_RESOLVER=le
# The shared networks every application joins. The names must match the root
# compose and Traefik, which own and create them (production.md §7.1).

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# DocumentServer's signing secret. It MUST be byte-identical to
# FILEBROWSER_ONLYOFFICE_SECRET in ../Filebrowser/.env, which FileBrowser sends as
# `integrations.office.secret`; a mismatch makes documents open read-only or not
# at all (IN-4.2, production.md §14.4). Generate one value with
# `openssl rand -base64 32` and put the same string in both files.
JWT_SECRET=replace-with-openssl-rand-base64-32
