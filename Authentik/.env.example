# Authentik/ — every variable `Authentik/compose.yaml` interpolates.
#
# Copy to `Authentik/.env` (or let `scripts/e2e.sh` and `setup.sh` generate it) and
# fill in the secrets. Nothing here is committed: `.env` is gitignored (P-16,
# O-13.1). The three secrets below are generated, never chosen:
#
#   PG_PASS=$(openssl rand -base64 36 | tr -d '\n')
#   AUTHENTIK_SECRET_KEY=$(openssl rand -base64 60 | tr -d '\n')
#   AUTHENTIK_BOOTSTRAP_TOKEN=$(openssl rand -hex 32)
#
# `Authentik/.env` is loaded by Compose for this folder's compose file, exactly
# like every other application folder. The root `.env` takes precedence for
# anything both files define, so shared settings have one home.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# ghcr.io/goauthentik/server (roadmap.md §5.2: "Provider/flow names referenced in
# OIDC.md are version-sensitive"). The pin is a full patch tag on the **2026.8**
# train, the current stable release. `authentik-api-feasibility.md` verified the API
# shapes against 2024.12.3, and several of them changed on the way here, so this is
# a provisioning change and not only a tag change:
#
#   * Redis is **gone** — removed in 2025.10, along with every `AUTHENTIK_REDIS__*`
#     setting. The compose file no longer defines the service (IN-7.2).
#   * `redirect_uris` is an array of **objects** (`{url, matching_mode}`). It was
#     already that on the pinned 2024.12.3, which the feasibility study now records;
#     the object form is what the library emits.
#   * `grant_types` must be sent **explicitly** from 2026.5 on: the serializer
#     default is an empty list and the authorize view rejects any grant not in it.
#   * The built-in `email` scope reports `email_verified` according to the train;
#     the custom `email-verified` mapping OIDC.md §4.5 defines is what makes the
#     claim unconditional, so the pin can move within reason without breaking
#     Zulip's check.
#
# Moving the pin is deliberate: bump it here, re-run the provisioning, and
# re-check the object shapes against `/api/v3/schema/`.
AUTHENTIK_TAG=2026.8.3

# ---------------------------------------------------------------------------
# Ingress
# ---------------------------------------------------------------------------
# The identity hostname. OIDC.md §4.3 builds every issuer from it:
# `https://<AUTHENTIK_HOST>/application/o/<slug>/`, and §4.7 puts the shared
# authorize/token/userinfo endpoints at `https://<AUTHENTIK_HOST>/application/o/`.
# production.md §5.4 derives it as `auth.<base domain>`.
AUTHENTIK_HOST=auth.example.com
# The ACME resolver name from Traefik's static configuration. Empty in the
# local/test profile, which serves the committed default certificate instead.
TRAEFIK_CERT_RESOLVER=le

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# The database password. Authentik reads it from the environment only
# (AUTHENTIK_POSTGRESQL__PASSWORD below); PostgreSQL reads the same value as
# POSTGRES_PASSWORD, so the two can never disagree.
PG_PASS=replace-with-openssl-rand-base64-36

# ---------------------------------------------------------------------------
# Authentik core
# ---------------------------------------------------------------------------
# Signs session cookies and encrypts stored secrets. Rotating it invalidates
# every session and every encrypted value, so it is generated once and backed up.
AUTHENTIK_SECRET_KEY=replace-with-openssl-rand-base64-60

# The built-in `akadmin` account (I-AK-2). The password is only read on the very
# first boot — later runs leave an existing account alone — and the email is what
# identifies the account. Leave the password empty to let Authentik generate one
# and print it once in the container log.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=

# The API token the first boot mints for `akadmin`. This is what makes the
# provisioning in production.md §5.5.3 possible without an operator copying a
# token out of the Web UI: it authenticates `scripts/lib/authentik.sh` against
# `POST /api/v3/...` from the first second the server answers.
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Behind Traefik
# ---------------------------------------------------------------------------
# IN-7.4: Authentik must trust the proxy's network, and Traefik must send
# `X-Forwarded-Proto: https`. Without this Authentik advertises an `http://`
# issuer and every client fails with `unexpected "iss" claim value`.
# 172.16.0.0/12 covers the private range Docker's bridge networks are carved
# from; narrow it on a host whose proxy network has a fixed subnet.
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Authentik's built-in error reporting is off: this deployment is self-hosted and
# every crash stays on the host (production.md §13).
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# ---------------------------------------------------------------------------
# What the provisioning writes back
# ---------------------------------------------------------------------------
# These are read by `scripts/lib/authentik.sh` and by the applications, not by
# `Authentik/compose.yaml`. They live in the ROOT `.env` (OIDC.md §9); this
# section is a reminder of the contract, and the values below are never used.
#
#   WORKCENTER_OIDC_CLIENT_ID / WORKCENTER_OIDC_CLIENT_SECRET
#   FILEBROWSER_OIDC_CLIENT_ID / FILEBROWSER_OIDC_CLIENT_SECRET
#   ZULIP_OIDC_CLIENT_ID / ZULIP_OIDC_CLIENT_SECRET
#   MAILCOW_OIDC_CLIENT_ID / MAILCOW_OIDC_CLIENT_SECRET
#   WORKCENTER_USER_GROUP=workspaceusers
#   WORKCENTER_ADMIN_GROUP=workspaceadmin
#   AUTHENTIK_URL=https://auth.example.com
#   TRAEFIK_FORWARDAUTH_ADDRESS=http://authentik-server:9000/outpost.goauthentik.io/auth/traefik
