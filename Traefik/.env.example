# Workcenter — Traefik configuration (roadmap.md Phase 3.3). Copy to .env and fill in.
#
# `.env` is gitignored (P-16). Compose interpolates these values; Traefik itself reads none of
# them — each key below names the file that does.
#
# A production host keeps the base domain and the five hostnames in the *root* .env
# (architecture.md §6.1, OIDC.md §9.1) because setup.sh writes them there (production.md §5.4).
# They are listed here too because this folder can be brought up on its own, and because the
# Host() rules in dynamic/ carry the same names until setup.sh rewrites them.

# --- Read by Traefik/compose.yaml --------------------------------------------
# ACME contact address. Let's Encrypt sends expiry warnings here, so production wants a monitored
# address; architecture.md §6.1's example value is compose.yaml's default too.
#
# This key is not the local-test switch: Compose's `:-` default also applies to an empty value, so
# an empty ACME_EMAIL still arrives as the default address. What keeps a test host off ACME is that
# no router names the `le` resolver — the test profile drops `certResolver` from every router
# (Testing.md §6.2, §6.3, architecture.md §5.7) — and dynamic/tls.yml then serves certs/local.crt as
# the default certificate. No DNS, no ACME account, no challenge.
ACME_EMAIL=admin@example.com
# Traefik image tag. compose.yaml defaults to v3.7: the docs pin `traefik:v3` (integration.md §2),
# P-27 requires at least v3.6 (`traefik.docker.allownonrunning`) and P-26 describes v3.7.3
# behaviour, so v3.7 is the newest minor that can be justified. Move it deliberately, not casually:
# it is the pin. architecture.md §6.1 names the key TRAEFIK_TAG.
TRAEFIK_TAG=v3.7
# Traefik's own log level. INFO is the floor traefik.yml sets; P-27 notes the upstream default is
# ERROR, so an empty log means nothing is wrong. Raise this to DEBUG while debugging, then restore.
TRAEFIK_LOG_LEVEL=INFO

# --- Domain map (written by setup.sh; no file in Traefik/ reads these) -------
# BASE_DOMAIN is the root domain; the five URLs are derived by prefixing filebrowser., auth.,
# mail., chat. and traefik. to it (production.md §5.4, OIDC.md §8.3). They feed the Host() rules
# in the app composes and in dynamic/dashboard.yml.
BASE_DOMAIN=example.com
WORKCENTER_URL=https://example.com
FILEBROWSER_URL=https://filebrowser.example.com
AUTH_URL=https://auth.example.com
MAIL_URL=https://mail.example.com
CHAT_URL=https://chat.example.com
TRAEFIK_URL=https://traefik.example.com

# --- Phase 5 (roadmap.md §5.7) ----------------------------------------------
# Outpost forward-auth URL. setup.sh writes it into dynamic/middlewares.yml as the address of the
# `authentik@file` middleware (OIDC.md §5.8, §9.1). No file in this folder reads it yet.
# TRAEFIK_FORWARDAUTH_ADDRESS=http://authentik-server:9000/outpost.goauthentik.io/auth/traefik
