# ---------------------------------------------------------------------------
# Zulip/.env.example — every variable Zulip/compose.yaml reads, plus two this
# folder owns for the deployment scripts: the release commit recorded below and
# `ZULIP_ORGANIZATION_NAME`, which `setup.sh` and `scripts/e2e.sh` read when they
# create the organization (neither is an input to `compose`).
#
# Copy to Zulip/.env and fill in; `setup.sh` writes the real file (production.md
# §5.2, Stage B) and .env is gitignored (P-16). Values are the deployment's own
# — the base domain comes from the Stage D prompt (production.md §5.4), and the
# hostnames are derived from it by prefix, so `chat.` is applied once, here.
#
# No secret belongs in this file. Every secret is a file under Zulip/secrets/
# (I-ZU-3, IN-5.3) — with one documented exception, the OIDC client secret, which
# has to travel inside ZULIP_CUSTOM_SETTINGS because that setting is raw Python
# (see the authentication section below).
#
# THE RELEASE WORKCENTER IS BUILT AGAINST: **Zulip 12.3**
# (`ghcr.io/zulip/zulip-server:12.3-0`, upstream commit `b3198225…`). Workcenter
# runs that image **unmodified** — nothing is added to it and no derived tag is
# built. Later Zulip releases are adopted deliberately, tested against this
# deployment, then released after Workcenter's own initial release, by moving the
# tag below with `./scripts/e2e.sh --bump-zulip-pin`. The Markdown specification
# set is not rewritten by that command: it records the release the application was
# built against when it was written.
# ---------------------------------------------------------------------------

# --- images (pinned; no floating `latest`) ---------------------------------
# The pinned upstream server image, exactly as upstream publishes it. The root
# composition's .env declares the same tag and wins when the root project includes
# this file, so the two must agree.
ZULIP_IMAGE=ghcr.io/zulip/zulip-server:12.3-0
# The exact upstream revision that tag resolves to: a record of what this
# deployment was tested against, not an input. Nothing reads it, and
# `./scripts/e2e.sh --bump-zulip-pin --zulip-version X.Y --zulip-commit <sha>`
# keeps it in step with the tag above.
ZULIP_UPSTREAM_COMMIT=b31982251ff82d0b02e59f63ad21f19204e37aea

# The four support images. These are the tags docker-zulip's own compose.yaml
# pins at 12.3-0 (integration.md §5.3); the services they run are not optional
# (I-ZU-1). `memcached:alpine` and `redis:alpine` are the upstream floating minor
# tags — not `latest`, but on a production host pin them by digest here, for
# example `redis:alpine@sha256:<digest>`; nothing else in the stack assumes the
# tag form.
ZULIP_POSTGRES_IMAGE=zulip/zulip-postgresql:14
MEMCACHED_IMAGE=memcached:alpine
RABBITMQ_IMAGE=rabbitmq:4.2
REDIS_IMAGE=redis:alpine

# --- the organization ------------------------------------------------------
# The Zulip **organization** ("realm") Workcenter deploys. A Zulip server has no
# organization until one is created, and without one every page on the Chat host
# answers 404 "There is no Zulip organization at <host>" — the pane renders
# nothing and the broker has nothing to talk to, whatever else is healthy. The
# pinned image creates none of its own, so the deployment does, once:
#
#   * `setup.sh` asks whether to create one and what to call it, then runs
#     `manage.py create_realm` inside the container (production.md §5.2, P-36);
#   * `scripts/e2e.sh` creates it for a test run, which is what makes the pane
#     testable out of the box (Testing.md §6.5);
#
# and both leave an existing organization alone, because Zulip's database outlives
# a run. The command is idempotent by that check, not by retrying.
#
# The owner is the deployment's administrator (`ZULIP_EMAIL` →
# SETTING_ZULIP_ADMINISTRATOR below), and the owner account is created with a
# **disabled password**: Zulip's production create path generates none and none is
# written here, so signing in is OIDC (Phase 5) or a password reset. Leave this
# empty to deploy no organization deliberately — the Chat pane then reports that
# Zulip has none, which is the honest state rather than a broken pane.
ZULIP_ORGANIZATION_NAME=Workcenter

# --- hostnames, and the certificate identifier set -------------------------
# Zulip's public hostname: `chat.` + the base domain (roadmap §5.1). It is also
# the Traefik router rule, so the certificate, the redirect URI registered in
# Authentik (`https://<this>/complete/oidc/`, I-ZU-5) and the Host Traefik passes
# through can never disagree.
SETTING_EXTERNAL_HOST=chat.example.com
# The person or team Zulip contacts about this installation; it appears on error
# pages and as the sender of automated mail. docker-zulip requires it, and
# compose.yaml fills SETTING_ZULIP_ADMINISTRATOR from this value. The name is the
# root .env's, so there is one place to change the address.
ZULIP_EMAIL=zulip@example.com
# The Workcenter origin allowed to frame the Chat pane is **not set here**. It is
# the CSP `frame-ancestors` allow-list in Traefik/dynamic/middlewares.yml, which
# `setup.sh` rewrites from the deployment's base URL — scheme + host of the shell,
# not of Zulip, and never `*` (IN-5.8, production.md §5.4). Nothing inside Zulip
# reads an origin: Zulip ships `X-Frame-Options: DENY` and the browser ignores that
# header once Traefik has set `frame-ancestors` (integration.md §8.4).

# The hostname set every Traefik router in this repository declares, so the `le`
# resolver orders one certificate for all of them instead of one per router —
# Let's Encrypt allows five per exact identifier set per week (P-25). setup.sh
# writes these from the base URL (production.md §5.4) into the root .env and here;
# the values must be identical in both, and CHAT_HOST must equal
# SETTING_EXTERNAL_HOST above. OFFICE_HOST is listed because OnlyOffice has a
# hostname in the same set even though no Workcenter pane frames it.
BASE_DOMAIN=example.com
WORKCENTER_HOST=example.com
FILEBROWSER_HOST=filebrowser.example.com
CHAT_HOST=chat.example.com
MAIL_HOST=mail.example.com
OFFICE_HOST=office.example.com

# --- the reverse proxy -----------------------------------------------------
# The addresses Zulip treats as its proxy, and one of the two settings a manual
# deployment gets wrong first:
#   * a request that does not arrive from a listed address is answered with HTTP
#     500 "Reverse proxy misconfiguration" — Zulip's nginx flags it with
#     `X-Proxy-Misconfiguration` and Django refuses the page, so the whole Chat
#     pane breaks, not only /health;
#   * `/health` is additionally IP-restricted (`allow 127.0.0.1; allow <these>;
#     deny all`), so a probe from an unlisted address answers 403 — which looks
#     exactly like an application failure (IN-5.14).
# Comma-separated IPs or CIDRs, written to zulip.conf [loadbalancer] ips. nginx
# uses each entry as a `set_real_ip_from` rule and as an `allow` entry, and Zulip
# compares the request's address against the same list; a CIDR is accepted (both
# `172.18.0.3` and `172.18.0.0/16` work on the pinned 12.3).
# The variable is `LOADBALANCER_IPS`, *not* `SETTING_LOADBALANCER_IPS`: there is
# no such Zulip setting, and the SETTING_-prefixed name would be written to
# settings.py and silently ignored.
# The shipped healthcheck probes from 127.0.0.1 and needs that entry. Add the
# address Traefik presents on the proxy network, or its whole subnet, or every
# page fails:
#   docker network inspect proxy \
#     -f '{{range .Containers}}{{.Name}} {{.IPv4Address}}{{"\n"}}{{end}}'
# `scripts/e2e.sh` reads Traefik's address after the proxy network exists and sets
# this for the test run (Testing.md §6.5).
LOADBALANCER_IPS=127.0.0.1
# Set by the compose file as belt and braces for a rewritten Host header;
# Traefik's default (pass the client Host through) is the primary mechanism
# (IN-5.13), so this is `True` because roadmap I-ZU-7 asks for it, not because
# anything here needs it.
SETTING_USE_X_FORWARDED_HOST=True

# --- outbound email --------------------------------------------------------
# Zulip sends invitations, notifications and password resets; without a working
# relay those features fail silently in the UI. The SMTP password is the file
# secret Zulip/secrets/zulip__email_password (I-ZU-3) — never a value here.
# Note that Mailcow's postfix owns host port 25 in this deployment, so point this
# at Mailcow through the host gateway or at an external relay.
SETTING_EMAIL_HOST=postfix.example.com
SETTING_EMAIL_PORT=587
SETTING_EMAIL_HOST_USER=noreply@example.com
SETTING_EMAIL_USE_TLS=True
SETTING_NOREPLY_EMAIL_ADDRESS=noreply@example.com

# --- authentication --------------------------------------------------------
# Bare class names: docker-zulip prepends `zproject.backends.` (I-ZU-5).
# EmailAuthBackend keeps a break-glass password login working; dropping
# GenericOpenIdConnectBackend silently disables Authentik sign-in for Chat.
ZULIP_AUTH_BACKENDS=EmailAuthBackend,GenericOpenIdConnectBackend

# Dict-valued settings cannot be expressed as SETTING_*, so this is raw Python
# appended to settings.py (I-ZU-4, IN-5.5, OIDC.md §6.3). It *is* code: a syntax
# error prevents Zulip from starting, and it is reviewed as such.
#
# The block assigns SOCIAL_AUTH_OIDC_ENABLED_IDPS rather than updating it, which
# is deliberate: Zulip 12.3's settings template defines that setting
# unconditionally with a placeholder `idp_name` entry, and assigning replaces the
# placeholder instead of leaving a bogus "Log in with Example" button.
#
# `oidc` is the IdP name used in /login/oidc/?idp=oidc and in the redirect URI
# `https://chat.example.com/complete/oidc/` registered in Authentik (I-ZU-5).
# `oidc_url` is the Authentik issuer base path with no trailing slash.
#
# The client secret is the one exception to "secrets are files": it travels in
# this Python block, in `.env`, which is gitignored. The hardened alternative is
# Zulip's own convention — put the secret in Zulip/secrets/
# zulip__social_auth_oidc_secret and read it here with
#   "secret": get_secret("social_auth_oidc_secret"),
# which keeps `.env` free of credentials entirely (OIDC.md O-6.8). Either way the
# placeholder below must be replaced.
#
# Multi-line quoted values are supported by Compose's .env parser. If a Compose
# version refuses the multi-line form, keep the block on one line with explicit
# \n escapes: the entrypoint appends it with `echo -e`, so escapes are
# interpreted.
ZULIP_CUSTOM_SETTINGS="
SOCIAL_AUTH_OIDC_ENABLED_IDPS = {
    'oidc': {
        'oidc_url': 'https://auth.example.com/application/o/zulip',
        'display_name': 'Workcenter',
        'client_id': 'REPLACE_WITH_THE_AUTHENTIK_CLIENT_ID',
        'secret': 'REPLACE_WITH_THE_AUTHENTIK_CLIENT_SECRET',
        'auto_signup': True,
        'extra_attrs': ['email', 'full_name', 'groups'],
    },
}
SOCIAL_AUTH_OIDC_FULL_NAME_VALIDATED = True
"
# Note on group-to-role sync: on Zulip 12.3 `zulip_groups` / `zulip_role` are
# accepted into the IdP configuration but not synchronised — OIDC group sync
# arrives in Zulip 13 (IN-5.18). `workspaceadmin` is therefore propagated out of
# band by setup.sh through the API (IN-5.19), and adding `groups` to extra_attrs
# now only prepares the upgrade.
