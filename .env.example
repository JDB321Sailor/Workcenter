# Workcenter — the deployment's own settings.
#
# Copy to `.env` (or let `scripts/e2e.sh` and `setup.sh` generate it) and fill in
# the values for your host. Every key here is read by `compose.yaml`,
# `compose.test.yaml` or one of the application folders; nothing reads a key that
# is not in this file, and no secret is ever committed — `.env` is gitignored
# (production.md P-16).

# ---------------------------------------------------------------------------
# Hostnames
#
# One base domain, six hostnames derived from it (production.md §5.4). The shell
# answers on the bare domain; the applications each get a subdomain so their
# cookies stay on their own origin (broker.md §4.2 depends on that).
# ---------------------------------------------------------------------------
BASE_DOMAIN=example.com
WORKCENTER_HOST=example.com
FILEBROWSER_HOST=filebrowser.example.com
CHAT_HOST=chat.example.com
MAIL_HOST=mail.example.com
OFFICE_HOST=office.example.com
TRAEFIK_HOST=traefik.example.com

# ---------------------------------------------------------------------------
# Traefik
#
# The ACME resolver name the routers ask for. Leave it empty only for local
# testing: with no resolver, Traefik serves the default certificate from
# Traefik/dynamic/tls.yml, which is what the harness installs.
# ---------------------------------------------------------------------------
TRAEFIK_CERT_RESOLVER=le
ACME_EMAIL=you@example.com
TRAEFIK_IMAGE=traefik:v3.2

# ---------------------------------------------------------------------------
# Networks
#
# The names are fixed, not configurable: Traefik owns `proxy` and the root
# composition owns `internal` (compose.yaml). A configurable name would have to be
# interpolated into every `traefik.docker.network` label as well, and Compose
# refuses to merge two declarations of one network that differ at all.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Workcenter
# ---------------------------------------------------------------------------
WORKCENTER_IMAGE=workcenter:dev
WORKCENTER_VERSION=dev
# The directory FileBrowser serves and the broker reads and writes by path. Both
# containers must mount the same host directory, or the broker disables the
# by-path flows at startup (broker.md §5.3, integration.md IN-9.6).
#
# It must be an ABSOLUTE path, and that is not a style preference: the root
# composition pulls the application composes in with `include:`, and each
# included file resolves a relative bind-mount path against *its own*
# directory. A relative value would therefore point the FileBrowser container
# at Filebrowser/... and the Workcenter container at the repository root — two
# different host directories, which is precisely the mis-mount the broker
# refuses at startup. Keep it inside the deployment root so backups stay one
# rsync (production.md P-17).
FILEBROWSER_SOURCE_PATH=/opt/workcenter/Filebrowser/data/files

# ---------------------------------------------------------------------------
# FileBrowser Quantum
# ---------------------------------------------------------------------------
FILEBROWSER_IMAGE=gtstef/filebrowser:2.0.9-beta
# The office integration (integration.md IN-4.2, architecture.md AR-19): the URL
# the Files pane calls, and the shared secret it signs its callbacks with.
# FILEBROWSER_ONLYOFFICE_SECRET is what FileBrowser reads (its config fails
# validation when it is empty, so the container will not start without it) and
# JWT_SECRET is what ONLYOFFICE reads. The two MUST be byte-identical: it is one
# shared secret seen from both ends, not two. Generate it with
# `openssl rand -base64 32`.
ONLYOFFICE_URL=https://office.example.com
FILEBROWSER_ONLYOFFICE_SECRET=replace-me-with-openssl-rand-base64-32
JWT_SECRET=replace-me-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# ONLYOFFICE Docs
# ---------------------------------------------------------------------------
ONLYOFFICE_IMAGE=onlyoffice/documentserver:8.2.2
JWT_ENABLED=true

# ---------------------------------------------------------------------------
# Zulip
#
# ZULIP_IMAGE is the pinned **upstream** image Workcenter runs unmodified (see
# Zulip/.env.example and Zulip/compose.yaml for the settings only Zulip reads).
# Nothing is built for Zulip: the framing header that lets the shell embed the chat
# pane is supplied by Traefik's `security-headers@file` middleware, which names the
# shell's origin (integration.md §8.4, IN-5.8). The release Workcenter is built
# against during the construction phase is **Zulip 12.3**;
# `./scripts/e2e.sh --bump-zulip-pin` moves the tag when a later release is adopted.
# ---------------------------------------------------------------------------
ZULIP_IMAGE=ghcr.io/zulip/zulip-server:12.3-0
ZULIP_EMAIL=zulip@example.com

# ---------------------------------------------------------------------------
# Broker limits (Phase 6 reads these; they are declared now so the deployment
# and the specification agree on one set of names — broker.md §10.1)
# ---------------------------------------------------------------------------
BROKER_MAX_TRANSFER_MIB=512
BROKER_MAX_FILENAME=200
BROKER_CONCURRENCY=3
# 32 bytes, base64. Generate with: openssl rand -base64 32
BROKER_VAULT_KEY=
# The mail endpoint inside the compose network, and the name its certificate is
# valid for (Mailcow's generated certificate is CN-only, with no SAN).
BROKER_IMAP_HOST=dovecot
BROKER_IMAP_PORT=993
BROKER_IMAP_TLS_SERVERNAME=mail.example.com
BROKER_IMAP_CA=./Mailcow/data/assets/ssl/cert.pem
