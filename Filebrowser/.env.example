# Filebrowser/ — every variable `Filebrowser/compose.yaml` interpolates, plus the
# one setup.sh reads to write the office URL into `config.yaml`.
#
# Copy to `Filebrowser/.env`. Compose loads this file automatically for this
# folder's compose file, whether it is run directly
# (`docker compose -f Filebrowser/compose.yaml up -d`) or reached through the
# root composition's `include:`. The root `.env` takes precedence over these
# values for anything both files define, so shared settings have one home.
#
# Nothing here is a secret: the values below are placeholders (A-6.12).

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# gtstef/filebrowser:2.0.9-beta (I-FB-1). The equivalent registry is
# ghcr.io/gtsteffaniak/filebrowser with the same tag. The beta line has no
# `latest`, so the tag is explicit and moving it is a deliberate change.
FILEBROWSER_IMAGE=gtstef/filebrowser:2.0.9-beta

# ---------------------------------------------------------------------------
# Ingress and networks
# ---------------------------------------------------------------------------
# The Files subdomain: the Traefik router rule is built from it, and its host is
# what Authentik must register as the OIDC redirect URI, because FileBrowser
# derives that URI from the incoming request (IN-3.5). production.md §5.4 derives
# it as `filebrowser.<base domain>`.
FILEBROWSER_HOST=filebrowser.example.com
# The ACME resolver name from Traefik's static configuration (production.md §7.2).
TRAEFIK_CERT_RESOLVER=le
# The shared networks every application joins. The names must match the root
# compose and Traefik, which own and create them (production.md §7.1).

# ---------------------------------------------------------------------------
# The shared file tree
# ---------------------------------------------------------------------------
# The directory FileBrowser serves and the broker reads and writes by path. It
# must be the SAME host directory the Workcenter container mounts as /srv/files,
# and it must be ABSOLUTE: with `include:` a relative value resolves against
# Filebrowser/ for this mount but against the repository root for the Workcenter
# mount, so the broker would report root-mismatch at startup and disable the
# by-path flows (IN-9.6, AR-35, broker.md §5.3, production.md §14.3).
FILEBROWSER_SOURCE_PATH=/opt/workcenter/Filebrowser/data/files

# ---------------------------------------------------------------------------
# Office integration
# ---------------------------------------------------------------------------
# The browser-facing OnlyOffice address. Read by setup.sh, which writes it into
# `integrations.office.url` in config.yaml (production.md §5.2a) — config.yaml is
# mounted as a file and FileBrowser does not expand environment variables, so
# this value is not interpolated by the compose file.
ONLYOFFICE_URL=https://office.example.com
# The shared JWT secret: generated with `openssl rand -base64 32` (IN-4.2) and
# byte-identical to the JWT_SECRET in ../OnlyOffice/.env. It is required, not
# optional: FileBrowser validates `integrations.office.secret` at startup, so an
# empty value stops the container. Replace this placeholder before deploying.
FILEBROWSER_ONLYOFFICE_SECRET=replace-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# OIDC (Phase 5 fills these in)
# ---------------------------------------------------------------------------
# The Authentik provider's client credentials. Phase 5 writes them together with
# the `auth.methods.oidc` block in config.yaml (AR-19, I-FB-5); from that point
# provider discovery runs at startup and a failure is fatal (IN-3.6).
FILEBROWSER_OIDC_CLIENT_ID=
FILEBROWSER_OIDC_CLIENT_SECRET=
# The HMAC key for the session cookie, generated with `openssl rand -base64 32`.
# Left empty, the application generates one and stores it in its database.
FILEBROWSER_JWT_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# The built-in admin account (IN-3.26)
# ---------------------------------------------------------------------------
# FileBrowser Quantum creates one admin user on first start. Its username is
# always `admin` — there is no environment variable for that — and its password
# comes from `FILEBROWSER_ADMIN_PASSWORD`, the only admin setting the application
# reads from the environment. Left empty, the pinned version falls back to its own
# default, which is also `admin`: a deployment must set a real value (generate one
# with `openssl rand -base64 32`) before the Files host is reachable, or the admin
# login is public knowledge. `scripts/e2e.sh` sets `admin` for a test run so the
# testing login is known and printed; this file never carries a value (A-6.12).
FILEBROWSER_ADMIN_PASSWORD=
